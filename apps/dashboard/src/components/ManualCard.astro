---
// Optional hand-set mark for a service without any API (not used by the router); one slim row item.
import type { ManualCardOverview } from '@core/overview';

interface Props {
  card: ManualCardOverview;
}
const { card } = Astro.props;
const label = card.state === 'exhausted' ? 'вичерпано' : card.state === 'available' ? 'доступно' : 'не позначено';
const when = card.at ? new Date(card.at).toLocaleString('uk-UA', { dateStyle: 'short', timeStyle: 'short' }) : '';
---

<div class:list={['manual__item', card.state === 'exhausted' && 'manual__item--exhausted']} role="group" aria-labelledby={`manual-${card.id}`}>
  <span class="manual__name" id={`manual-${card.id}`}>{card.title}</span>
  <span class:list={['badge', 'badge--sm', card.state === 'exhausted' ? 'badge--exhausted' : card.state ? 'badge--available' : 'badge--unknown']}>
    <span class="badge__dot" aria-hidden="true"></span>
    <span class="visually-hidden">Статус: </span>{label}
  </span>
  <form class="manual__actions" method="post" action="/api/manual" data-async>
    <input type="hidden" name="id" value={card.id} />
    <button class="btn btn--sm" type="submit" name="state" value="available" aria-pressed={card.state === 'available'}>Доступно</button>
    <button class="btn btn--sm" type="submit" name="state" value="exhausted" aria-pressed={card.state === 'exhausted'}>Вичерпано</button>
  </form>
  {when && <time class="manual__when" datetime={card.at}>{when}</time>}
</div>
