---
// "Нова задача": starts `sb run` through /api/tasks. Rendered once (outside the polled region) so
// text typed into it is never replaced by a refresh.
import type { ProjectOption } from '@core/task-overview';

interface Props {
  types: { id: string; short: boolean }[];
  projects: ProjectOption[];
}
const { types, projects } = Astro.props;

const TYPE_LABEL: Record<string, string> = {
  research: 'Дослідження',
  ideas: 'Ідеї',
  copy: 'Тексти',
  section: 'Секція (Astro)',
  review: 'Рев’ю',
  qa: 'QA',
};
---

<section class="panel" aria-labelledby="new-task-title">
  <h3 class="panel__title" id="new-task-title">Нова задача</h3>
  {
    projects.length === 0 && (
      <p class="panel__hint">
        Немає дозволених проєктів. Додай один командою <code>pnpm sb project add ~/шлях/до/проєкту</code> (або запусти будь-яку задачу через <code>sb run</code>).
      </p>
    )
  }
  <form class="form" method="post" action="/api/tasks" data-async data-task-form>
    <div class="field">
      <label for="task-text">Що зробити</label>
      <textarea id="task-text" name="text" rows="3" maxlength="5000" required placeholder="Наприклад: зроби секцію Features за DESIGN.md, мобільна версія спочатку"></textarea>
    </div>
    <div class="form__row">
      <div class="field">
        <label for="task-type">Тип</label>
        <select id="task-type" name="type">
          {types.map((t) => <option value={t.id} selected={t.id === 'section'}>{TYPE_LABEL[t.id] ?? t.id}{t.short ? '' : ' (довга)'}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="task-priority">Пріоритет</label>
        <select id="task-priority" name="priority">
          <option value="normal">звичайний</option>
          <option value="high">високий</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="task-project">Проєкт</label>
      <select id="task-project" name="project" required disabled={projects.length === 0}>
        {projects.map((p) => <option value={p.path} title={p.path}>{p.name}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="task-figma">Figma-фрейм <span class="field__opt">(необов’язково)</span></label>
      <input id="task-figma" name="figma" type="url" inputmode="url" placeholder="https://www.figma.com/design/…" />
    </div>
    <button class="btn btn--primary" type="submit" disabled={projects.length === 0}>Запустити</button>
  </form>
</section>
