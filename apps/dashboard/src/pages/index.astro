---
// The whole dashboard is one React island fed by GET /api/state (see components/app/App.tsx).
import App from '../components/app/App';
import Base from '../layouts/Base.astro';
import { checkRequest, forbidden } from '../guard';

const denied = checkRequest(Astro.request);
if (denied) return forbidden(denied);
Astro.response.headers.set('cache-control', 'no-store');
---

<Base title="Switchboard · Ліміти і задачі">
  <App client:only="react">
    <p slot="fallback" class="p-6 text-sm text-muted-foreground">Завантажую…</p>
  </App>
</Base>
