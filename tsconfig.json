{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@core/*": [
        "./packages/core/*"
      ]
    }
  },
  "include": [
    "packages",
    "bin",
    "test",
    "apps/dashboard/src/**/*.ts"
  ]
}
